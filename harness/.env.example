# copy to .env and fill in. .env is gitignored.

# classify stage
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLASSIFY_MODEL=claude-haiku-4-5
# optional bigger model for the caching off-vs-on comparison
CLASSIFY_MODEL_HEADLINE=claude-sonnet-5

# pipeline
PIPELINE_MODE=v1          # v0 = serial monolith | v1 = fork-join fleet
HEAVY_C=2                 # worker_heavy concurrency (-c) — swept in Exp B
LIGHT_C=4                 # worker_light concurrency (-c)
CUT_THREADS=2             # ThreadPoolExecutor workers for the ffmpeg cut stage
CLASSIFY_THREADS=4        # ThreadPoolExecutor workers inside the classify task (1 vs 4)

# transcription
WHISPER_MODEL=base        # base int8 on CPU
WHISPER_COMPUTE=int8

# memory probe
MEM_CAP_GB=5              # worker_heavy memory limit (GB)

# db
POSTGRES_DB=repro
POSTGRES_USER=repro
POSTGRES_PASSWORD=repro
POSTGRES_HOST=db
POSTGRES_PORT=5432

# broker
REDIS_URL=redis://redis:6379/0

# cost/cache sweep
CACHE_SCOPES=1            # C: number of independent cache scopes (round-robin)
N_SCENES=200             # cap on total classify calls per sweep point (spend guard)
